# Copy to terraform.tfvars (git-ignored) and adjust.

app_name    = "flights"
environment = "dev"
aws_region  = "eu-north-1"
vpc_cidr    = "10.0.0.0/16"
single_nat  = true

kubernetes_version = "1.35"

# REQUIRED. Your public IP as /32: only these CIDRs reach the public EKS API.
# Find it with: curl -s https://checkip.amazonaws.com
public_access_cidrs = ["203.0.113.10/32"]

# Lab sizing. system hosts the platform, app hosts the workloads (tainted).
system_node_instance_type = "t3.medium"
system_node_min           = 2
system_node_desired       = 2
system_node_max           = 2

app_node_instance_type = "t3.large"
app_node_min           = 1
app_node_desired       = 1
app_node_max           = 2
